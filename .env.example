# Copy to .env and adjust as needed

# App
ENVIRONMENT=development
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_PREFIX=/api

# Database / Redis (Compose service hostnames when running via docker compose)
DATABASE_URL=postgresql+psycopg://nudge:nudge@db:5432/nudge
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Reminder engine
REMINDER_EVAL_INTERVAL_SECONDS=300
REMINDER_WEIGHTS_VERSION=v1
REMINDER_SEND_THRESHOLD=0.75
REMINDER_DIGEST_THRESHOLD=0.45
REMINDER_DAILY_CAP=12

# Email: console (default, logs to stdout) or smtp
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nudge@localhost

# Frontend (Vite): use /api with Compose nginx proxy (recommended).
# For bare `npm run dev` without proxy, use http://localhost:8000/api
VITE_API_URL=/api

# LLM (Phase 2 NL task intake) — OpenAI is the default provider.
# Leave OPENAI_API_KEY empty to use the deterministic stub (tests / offline UI).
# Set the key in your local .env only — never commit or paste secrets into chat.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=   # reserved; Phase 2 falls back to stub if selected
LLM_TIMEOUT_SECONDS=45
